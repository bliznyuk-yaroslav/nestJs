
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           Int      @id @default(autoincrement())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  age          Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
enum Role {
  USER
  ORGANIZER
  ADMIN
}
