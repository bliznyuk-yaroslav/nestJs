
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        Int       @id @default(autoincrement())
  name String 
  email String @unique
  password String
  role Role @default(USER)
  createdAt DataTime @default(now())
  updatedAt DataTime @updatedAt
  events Event[] @relation("OrganizerEvents")
  tickets Ticket[]
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}
